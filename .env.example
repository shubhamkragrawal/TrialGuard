# Non-secret runtime configuration.
# AWS credentials must come from a workload role, a durable scoped deployment
# identity supplied through a host's secret store, or your local AWS profile.
# Never put temporary workshop credentials in this file or on Render.
TRIALGUARD_AWS_REGION=us-east-1
TRIALGUARD_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
TRIALGUARD_BEDROCK_CHALLENGE_MODEL_ID=
TRIALGUARD_BEDROCK_GUARDRAIL_ID=
TRIALGUARD_BEDROCK_GUARDRAIL_VERSION=
TRIALGUARD_BEDROCK_NATIVE_JSON_SCHEMA=true
TRIALGUARD_LIVE_BEDROCK_ENABLED=false
TRIALGUARD_CLOUDWATCH_METRICS_ENABLED=false
TRIALGUARD_CLOUDWATCH_LOGS_ENABLED=false
TRIALGUARD_REGISTRY_BASE_URL=https://clinicaltrials.gov
TRIALGUARD_REPORT_TIMEOUT_SECONDS=90
# The fixed graph makes at most 5 role calls when its one revision path runs.
TRIALGUARD_MODEL_CALL_LIMIT=5
# In-memory per-process demo allowance; resets when the process restarts.
TRIALGUARD_DAILY_LIVE_RUN_LIMIT=15
TRIALGUARD_RATE_LIMIT_REQUESTS_PER_MINUTE=6
TRIALGUARD_CACHE_DIR=data/cache
TRIALGUARD_RUNS_DIR=runs
# Configure only rates verified for the selected model and deployment tier.
# Leave blank to show measured tokens without claiming a dollar estimate.
TRIALGUARD_INPUT_USD_PER_MILLION_TOKENS=
TRIALGUARD_OUTPUT_USD_PER_MILLION_TOKENS=
