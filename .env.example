# Non-secret runtime configuration.
# AWS credentials must come from an IAM role or your local AWS profile.
TRIALGUARD_AWS_REGION=us-east-1
TRIALGUARD_BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
TRIALGUARD_BEDROCK_CHALLENGE_MODEL_ID=
TRIALGUARD_BEDROCK_GUARDRAIL_ID=
TRIALGUARD_BEDROCK_GUARDRAIL_VERSION=
TRIALGUARD_LIVE_BEDROCK_ENABLED=false
TRIALGUARD_REGISTRY_BASE_URL=https://clinicaltrials.gov
TRIALGUARD_REPORT_TIMEOUT_SECONDS=90
TRIALGUARD_MODEL_CALL_LIMIT=8
TRIALGUARD_DAILY_LIVE_RUN_LIMIT=50
TRIALGUARD_RATE_LIMIT_REQUESTS_PER_MINUTE=6
TRIALGUARD_CACHE_DIR=data/cache
TRIALGUARD_RUNS_DIR=runs
# Amazon Nova Lite Standard tier, verified for us-east-1 on 2026-09-26.
# Re-check https://aws.amazon.com/bedrock/pricing/ before a long-lived deployment.
TRIALGUARD_INPUT_USD_PER_MILLION_TOKENS=0.06
TRIALGUARD_OUTPUT_USD_PER_MILLION_TOKENS=0.24
